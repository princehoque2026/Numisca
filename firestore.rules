rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: uid, name, email, photoURL, role, wishlist, createdAt
    //
    // Collection: collectibles
    // Fields: id, name, type, country, year, quantity, price, imageUrl, rarity, status
    //
    // Collection: inventory
    // Fields: id, ownerUid, collectibleId, name, type, country, year, rarity, quantity, source, addedAt
    //
    // Collection: swaps
    // Fields: id, initiatorUid, receiverUid, initiatorItemIds, receiverItemIds, status, createdAt
    //
    // Collection: chats
    // Fields: id, type, name, participants, lastMessage, updatedAt
    //
    // Collection: messages (subcollection of chats)
    // Fields: id, chatId, senderUid, senderName, text, createdAt
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        ((request.auth.token.email == "princehoque2025@gmail.com" && request.auth.token.email_verified == true) ||
         (request.auth.token.email == "historyancient475@gmail.com" && request.auth.token.email_verified == true) ||
         (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['admin', 'collector'];
    }

    // Rules
    
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) && isValidUser(request.resource.data);
      allow update: if (isOwner(uid) && request.resource.data.role == resource.data.role) || isAdmin();
    }
    
    match /collectibles/{id} {
      allow read: if true;
      allow update: if isAuthenticated();
      allow create, delete: if isAdmin();
    }
    
    match /inventory/{id} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }
    
    match /swaps/{id} {
      allow read: if isAdmin() || (isAuthenticated() && (resource.data.initiatorUid == request.auth.uid || resource.data.receiverUid == request.auth.uid));
      allow create: if isAuthenticated() && request.resource.data.initiatorUid == request.auth.uid;
      allow update: if isAdmin() || (isAuthenticated() && (resource.data.initiatorUid == request.auth.uid || resource.data.receiverUid == request.auth.uid));
    }
    
    match /chats/{id} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      
      match /messages/{msgId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(id)).data.participants;
        allow create: if isAuthenticated() && request.auth.uid == request.resource.data.senderUid;
      }
    }

    match /transactions/{id} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userUid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.userUid == request.auth.uid;
    }
    
    match /notifications/{id} {
      allow read: if isAuthenticated() && resource.data.userUid == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userUid == request.auth.uid;
    }
  }
}
